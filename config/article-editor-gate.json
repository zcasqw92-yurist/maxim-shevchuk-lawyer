{
  "schemaVersion": 1,
  "ruleId": "canonical-article-editor-approval-gate",
  "spreadsheetId": "1W4014FzdUJWYDja7VUh5XXUsSuxtQIrcS5fWRX1rm24",
  "editorTab": "34_Редактор_статей_сайта",
  "editorGid": "340000340",
  "historyTab": "_35_Версии_статей_сайта",
  "historyGid": "350000350",
  "headerRow": 5,
  "firstDataRow": 6,
  "columns": {
    "articleId": "A",
    "version": "B",
    "status": "C",
    "slugOrUrl": "D",
    "order": "E",
    "blockType": "F",
    "textOrValue": "G",
    "linkOrAction": "H",
    "userComment": "I",
    "finalPreflight": "J",
    "approvedFingerprint": "K",
    "approvalEvidence": "L",
    "publishedSha": "M",
    "publicationComment": "N"
  },
  "userEditableContentColumns": ["G", "H", "I"],
  "fingerprint": {
    "algorithm": "sha256",
    "normalizationVersion": 1,
    "canonicalFields": [
      "articleId",
      "version",
      "slugOrUrl",
      "order",
      "blockType",
      "textOrValue",
      "linkOrAction"
    ],
    "trimOuterWhitespace": true,
    "normalizeLineEndings": true,
    "preserveInternalWhitespace": true,
    "sortByOrder": true
  },
  "allowedBlockTypes": [
    "META_TITLE",
    "META_DESCRIPTION",
    "H1",
    "LEAD",
    "SHORT_ANSWER",
    "H2",
    "H3",
    "P",
    "BULLET",
    "NUMBER",
    "RISK",
    "NOTE",
    "CTA_SOFT",
    "CTA_MAIN",
    "FAQ_Q",
    "FAQ_A",
    "RELATED",
    "AUTHOR"
  ],
  "approvalManifestDir": "reports/article-approvals",
  "requirements": {
    "prepareFullSiteStructureInEditorBeforeApproval": true,
    "editorIsOnlyPrepublicationCopySource": true,
    "explicitUserChatCommandRequired": true,
    "sheetStatusAloneNeverCountsAsApproval": true,
    "rereadLiveEditorAfterApprovalCommand": true,
    "runFinalEditorialPreflightAfterCommand": true,
    "reportEveryFoundIssueInChat": true,
    "stopPublicationWhenIssueFound": true,
    "forbidSilentCorrectionsAfterApprovalCommand": true,
    "requireUserAgreementBeforeApplyingFoundCorrections": true,
    "snapshotOnlyAfterCleanAgreedPreflight": true,
    "requireSha256Fingerprint": true,
    "invalidateApprovalOnFingerprintDrift": true,
    "rereadAndRecomputeFingerprintBeforeSourceChange": true,
    "rereadAndRecomputeFingerprintBeforeMerge": true,
    "publishOnlyApprovedSnapshot": true,
    "recordPublishedShaBackToEditor": true
  },
  "publicationGateIds": ["PUB-025", "PUB-026", "PUB-027", "PUB-028", "PUB-029"],
  "prohibitions": [
    "publishing article copy from chat memory",
    "publishing an earlier export instead of the live editor tab",
    "treating a spreadsheet status as user approval",
    "running final preflight before the user's publication command and reusing it afterward",
    "silently correcting issues found during final preflight",
    "publishing after editor drift without a new explicit user approval",
    "overwriting the approved snapshot after drift",
    "merging article changes without an approval manifest and matching fingerprint"
  ]
}
